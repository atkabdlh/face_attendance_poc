# Copy this file to lib/.env and fill in the values.
# lib/.env is gitignored and must never be committed.

VERSION_NUMBER = '1',
APP_VERSION = '1.0.0',

# ENV = 'dev' / 'stg' / 'prod'
ENV = 'dev',

# Face-recognition (deepmin / Flask) backend — the only API the app actually calls.
FLASK_API_URL = 'http://<your-deepmin-host>:5001',

# Attendance records backend (currently unused by the app).
API_URL = 'https://api.example.com/api/v1',
STAGING_API_URL = 'https://stg-api.example.com/api/v1',
DEV_API_URL = 'https://dev-api.example.com/api/v1',

WEB_URL = 'https://app.example.com/',
STAGING_WEB_URL = 'https://stg.app.example.com',
DEV_WEB_URL = 'https://dev.app.example.com',
